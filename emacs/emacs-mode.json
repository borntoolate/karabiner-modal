              "key_code": "s",
              "modifiers": [
                "left_command"
              ]
            },
            {
              "set_variable": {
                "name": "emacs_x",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "emacs_mode",
              "value": 1
            },
            {
              "type": "variable_if",
              "name": "emacs_x",
              "value": 1
            }
          ]
        },
