{
  "title": "Emacs Mode (Caps Lock leader, Meta = Shift) - US layout",
  "maintainers": [
    "Naosuke Wakahara"
  ],
  "rules": [
    {
      "description": "Emacs mode (Caps Lock leader) - hold Caps Lock for C-, add Shift for M-  [US layout]",
      "manipulators": [
        {
          "type": "basic",
          "description": "Caps Lock: hold = Emacs leader (C-) / tap = nothing",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "emacs_mode",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "emacs_mode",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "emacs_mark",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "emacs_x",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "description": "C-g: keyboard-quit",
          "from": {
            "key_code": "g",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "set_variable": {
                "name": "emacs_mark",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "emacs_x",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "emacs_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "M-SPC: drop the mark",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "emacs_mark",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "emacs_mode",
              "value": 1
            },
            {
              "type": "variable_if",
              "name": "emacs_mark",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "M-SPC: set mark (selection follows every motion)",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "emacs_mark",
                "value": 1
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "emacs_mode",
              "value": 1
            },
            {
              "type": "variable_unless",
              "name": "emacs_mark",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "C-SPC: switch input source (control+space)",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "emacs_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "C-x C-s: save",
          "from": {
            "key_code": "s",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
